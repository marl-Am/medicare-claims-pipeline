# Data source. These three select which year the pipeline loads. Swap them
# for the commented block below to load 2023 instead; only one set should
# be active at a time.
DATA_ROOT=./data
CLAIM_YEAR_DIR=2024
CSV_FILENAME=Medicare_Physician_Other_Practitioners_by_Provider_and_Service_2024.csv

# CLAIM_YEAR_DIR=2023
# CSV_FILENAME=Medicare_Physician_Other_Practitioners_by_Provider_and_Service_2023.csv

# Database
PG_HOST=localhost
PG_PORT=5432
PG_DB=<your_database>
PG_USER=<your_username>
PG_PASSWORD=<your_password>
PG_SCHEMA=pg

# Host port for the API. docker-compose.yml defaults this to 8000.
API_PORT=8000